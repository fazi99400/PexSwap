{
  "name": "lifelox-contracts-solidity",
  "version": "1.0.0",
  "description": "Lifelox AMM core + periphery contracts for the pexli-v2 EVM lane",
  "license": "MIT",
  "scripts": {
    "build": "hardhat compile",
    "test": "node test/e2e.mjs",
    "deploy": "node scripts/deploy-standalone.mjs",
