# Pexli v2 network
VITE_PEXLI_CHAIN_ID=78901
VITE_PEXLI_RPC_URL=http://127.0.0.1:8545
VITE_PEXLI_EXPLORER=http://127.0.0.1:3000

# Lifelox deployed contracts (fill in from deploy.js output)
VITE_LIFELOX_FACTORY=0x...
VITE_LIFELOX_ROUTER=0x...
VITE_WPEX=0x...
# Optional — cross-lane factory (contracts/dual). When set, Rust-lane pools are
# listed next to the EVM ones in Positions.
VITE_LIFELOX_DUAL_FACTORY=0x...
VITE_LIFELOX_DUAL_ROUTER=0x...
VITE_LIFELOX_RUST_PROGRAM=Lifelox11111111111111111111111111111111111

# Demo tokens
VITE_TOKEN_USDP=0x...
VITE_TOKEN_PXLI=0x...
